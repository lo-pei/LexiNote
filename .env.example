# ── 会话签名 ────────────────────────────────────────────────
# 生产环境必须换成随机长串：openssl rand -base64 32
JWT_SECRET=lexinote-dev-secret-do-not-use-in-production-0001

# ── 数据库 ──────────────────────────────────────────────────
# 默认 data/lexinote.db；要指向别处时取消注释
# LN_DB_PATH=data/lexinote.db

# ── AI 辅助（可选）──────────────────────────────────────────
# 不填 AI_API_KEY 即为关闭：界面不出现 AI 入口，全站行为与接入前完全一致。
# 支持任何 OpenAI 兼容接口，换供应商只改 AI_BASE_URL 与 AI_MODEL。
#   DeepSeek  https://api.deepseek.com/v1        deepseek-chat
#   通义千问   https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
#   智谱 GLM   https://open.bigmodel.cn/api/paas/v4                glm-4-flash
#   本地 Ollama http://127.0.0.1:11434/v1        qwen2.5:14b
AI_ENABLED=1
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat

# 单次调用超时（毫秒）。单进程架构下这个值直接决定最坏情况的响应时间
AI_TIMEOUT_MS=15000
# 同时进行的模型请求上限。超过就排队，队列满则直接降级，不拖垮其他人的页面
AI_MAX_CONCURRENCY=2
