# ── 依赖与构建产物 ───────────────────────────────────────────
node_modules/
apps/web/.next*
out/
dist/
*.tsbuildinfo

# ── 本机数据（不进仓库）────────────────────────────────────
# data/ 里有数据库、本校课表、术语表导出与日志：含教师姓名、教室、
# 课程代码与学生名单，属于校本与个人信息，只留在部署机上。
data/
.shots/
*.log

# ── 交付物（只在本机生成，不入库）────────────────────────────
# 提交包/ 里是三份 PDF、源码 ZIP 与 14 张截图，约 5.7MB 二进制。
# 其中的 LexiNote-源代码.zip 是本仓库自身的快照，入库即冗余且立刻过期。
# 需要推某一份 PDF 时用 `git add -f 提交包/xxx.pdf` 单独加。
提交包/

# ── 环境变量 ────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── 编辑器与系统 ────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/

# ── 项目工作区记录 ──────────────────────────────────────────
.workbuddy/
