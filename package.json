{
  "name": "lexinote",
  "private": true,
  "version": "1.0.0",
  "description": "LexiNote — 法律英语交互式学习平台",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "launch": "node tooling/scripts/launch.mjs",
    "dev": "npm run dev --workspace @ln/web",
    "build": "npm run build --workspace @ln/web",
    "start": "npm run start --workspace @ln/web",
    "lint": "npm run lint --workspace @ln/web",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit",
    "db:reset": "tsx tooling/scripts/seed.mts",
    "db:seed": "tsx tooling/scripts/seed.mts",
    "textbook:import": "tsx tooling/scripts/import-textbook.mts",
    "laws:import": "tsx tooling/scripts/import-laws.mts"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=22.5"
  }
}
